# LogiFresh - Variables de Entorno

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=logifresh

# Pedidos Service
PEDIDOS_DB_NAME=logifresh_pedidos
PEDIDOS_SERVER_PORT=8081

# Inventario Service
INVENTARIO_DB_NAME=logifresh_inventario
INVENTARIO_SERVER_PORT=8082

# Facturacion Service
FACTURACION_DB_NAME=logifresh_facturacion
FACTURACION_SERVER_PORT=8083

# Transporte Service
TRANSPORTE_DB_NAME=logifresh_transporte
TRANSPORTE_SERVER_PORT=8084

# Notificaciones Service
NOTIFICACIONES_DB_NAME=logifresh_notificaciones
NOTIFICACIONES_SERVER_PORT=8085

# Database Connection Defaults
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
